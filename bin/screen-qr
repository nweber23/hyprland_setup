#!/usr/bin/env bash
# Pick a region, read the QR code (or barcode) in it, copy the content; links get an Open button.
# Needs: grim slurp zbar-tools, wl-clipboard, notify-send.
set -u
if [ -n "${SCREEN_IMAGE:-}" ]; then   # testing: read this image instead of picking a region
    img=$SCREEN_IMAGE
else
    region=$(slurp) || exit 0   # Esc cancels
    img=$(mktemp --suffix=.png)
    trap 'rm -f "$img"' EXIT
    grim -g "$region" "$img" || exit 1
fi
code=$(zbarimg -q --raw "$img" 2>/dev/null | head -c 4000)
if [ -z "$code" ]; then
    notify-send -a "QR code" -i dialog-warning "No code found" "Select the whole code with some margin."
    exit 1
fi
printf %s "$code" | wl-copy
case $code in
    http://*|https://*)
        action=$(notify-send -a "QR code" -i qrcode -A open=Open "Link copied" "$code")
        # only plain http(s) links are opened: a code must not be able to start anything else
        if [ "$action" = open ]; then xdg-open "$code"; fi ;;
    *) notify-send -a "QR code" -i qrcode "Copied" "${code:0:240}" ;;
esac
