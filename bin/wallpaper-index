#!/usr/bin/env python3
"""Index the wallpaper folders for the picker: images in ~/Pictures/Wallpapers, videos (animated wallpapers) in
~/Videos/Wallpapers and ~/Videos/Hidamari.

Writes a 480x270 thumbnail per image to ~/.cache/quickshell/thumbs and prints a JSON list
[{path, name, thumb, tags, video}] on stdout. tags are colour classes (red..pink, mono), "dark" and
"animated" for videos.
Results are cached by file mtime, so only new or changed images are decoded again.
"""
import colorsys, hashlib, json, subprocess, sys
from pathlib import Path
from PIL import Image, ImageOps

SRCS = [Path.home() / "Pictures" / "Wallpapers", Path.home() / "Videos" / "Wallpapers", Path.home() / "Videos" / "Hidamari"]
CACHE = Path.home() / ".cache" / "quickshell"
THUMBS = CACHE / "thumbs"
INDEX = CACHE / "wallpapers.json"
EXT = {".jpg", ".jpeg", ".png", ".webp"}
VIDEO = {".mp4", ".mkv", ".webm", ".mov"}
HUES = [(15, "red"), (45, "orange"), (70, "yellow"), (165, "green"), (200, "cyan"),
        (255, "blue"), (300, "purple"), (345, "pink"), (361, "red")]


def tags_for(im):
    px = list(im.resize((32, 32)).getdata())
    hsv = [colorsys.rgb_to_hsv(r / 255, g / 255, b / 255) for r, g, b in px]
    tags = []
    if sum(v for _, _, v in hsv) / len(hsv) < 0.25:
        tags.append("dark")
    vivid = [(h, s * v) for h, s, v in hsv if s > 0.25 and v > 0.2]
    if len(vivid) < len(hsv) * 0.15:
        tags.append("mono")
        return tags
    # Hue is an angle: average it as a vector, weighted by how vivid each pixel is.
    import math
    x = sum(w * math.cos(h * 2 * math.pi) for h, w in vivid)
    y = sum(w * math.sin(h * 2 * math.pi) for h, w in vivid)
    deg = (math.degrees(math.atan2(y, x)) + 360) % 360
    tags.insert(0, next(name for limit, name in HUES if deg < limit))
    return tags


def main():
    THUMBS.mkdir(parents=True, exist_ok=True)
    old = {}
    try:
        old = {e["path"]: e for e in json.loads(INDEX.read_text())}
    except (OSError, ValueError):
        pass
    out = []
    files = [f for d in SRCS if d.is_dir() for f in d.iterdir() if f.suffix.lower() in EXT | VIDEO]
    for f in sorted(files, key=lambda p: p.name.lower()):
        path, mtime = str(f), f.stat().st_mtime
        thumb = THUMBS / (hashlib.sha1(path.encode()).hexdigest()[:16] + ".jpg")
        e = old.get(path)
        if e and e.get("mtime") == mtime and thumb.exists():
            out.append(e)
            continue
        try:
            video = f.suffix.lower() in VIDEO
            if video:   # one frame, small: a 4K clip takes well under a second
                for t in ("2", "0"):
                    subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", t, "-i", path, "-frames:v", "1",
                                    "-vf", "scale=480:270:force_original_aspect_ratio=increase,crop=480:270", "-q:v", "4", str(thumb)],
                                   check=False, timeout=60)
                    if thumb.exists() and thumb.stat().st_size > 0:
                        break
                im = Image.open(thumb).convert("RGB")
            else:
                with Image.open(f) as im0:
                    im0.draft("RGB", (960, 540))   # JPEG: decode at reduced size
                    im = ImageOps.fit(im0.convert("RGB"), (480, 270))
                    im.save(thumb, quality=85)
            tags = tags_for(im) + (["animated"] if video else [])
            out.append({"path": path, "mtime": mtime, "name": f.stem, "thumb": str(thumb), "tags": tags, "video": video})
        except Exception as ex:   # unreadable or huge file: skip it, keep going
            print(f"skip {f.name}: {ex}", file=sys.stderr)
    INDEX.write_text(json.dumps(out))
    json.dump(out, sys.stdout)


main()
