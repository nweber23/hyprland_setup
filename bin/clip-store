#!/usr/bin/env python3
"""Add the text on stdin to the clipboard history (called by `wl-paste --watch`).

Keeps the newest 100 entries in ~/.local/share/clipboard/history.json (mode 600), newest first,
without duplicates, as [{"t": text, "ts": unix time}]. Entries expire after 24 h. Empty or very
large (> 20 kB) texts are ignored, and so is anything wl-paste marks as sensitive (password
managers set the hint), cleared or empty: CLIPBOARD_STATE must be "data".
"""
import json, os, sys, time
from pathlib import Path

DIR = Path.home() / ".local" / "share" / "clipboard"
FILE = DIR / "history.json"
LIMIT, MAX_LEN, TTL = 100, 20_000, 24 * 3600

if os.environ.get("CLIPBOARD_STATE") != "data":
    sys.exit(0)
text = sys.stdin.read()
if not text.strip() or len(text) > MAX_LEN:
    sys.exit(0)

DIR.mkdir(parents=True, exist_ok=True)
try:
    items = json.loads(FILE.read_text())
except (OSError, ValueError):
    items = []
now = time.time()
items = [{"t": text, "ts": now}] + [i for i in items if isinstance(i, dict) and i["t"] != text and now - i["ts"] < TTL]
tmp = FILE.with_suffix(".tmp")
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # history can hold secrets: owner only
with os.fdopen(fd, "w") as f:
    json.dump(items[:LIMIT], f)
os.replace(tmp, FILE)
